# Staged checkouts and stage reports. A staged tree is a mutated worktree of a
# target branch and is rebuilt from the branch on every run; it is never a
# source of truth and never needs committing.
stage/
wt/

# Reports from a local publish dry run.
dist-stage.json

# Publish transcripts. The release workflow keeps its own as a run artifact; a
# hand release writes one here.
publish.log
publish-resume.log

__pycache__/
*.pyc
wt-*/

# A tool binary fetched on demand, with its checksum verified: actionlint, by
# checks/workflows.py. It is reproducible from the pinned version, so it is not
# a source of truth either.
.cache/
